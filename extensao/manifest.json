{
  "manifest_version": 3,
  "name": "Timeline YT",
  "version": "1.1.0",
  "description": "Sinaliza vídeos do YouTube para a sua Timeline YT: mais disso, menos disso, assistir depois e o que você assistiu.",
  "permissions": ["storage", "alarms", "contextMenus", "scripting", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.faaretz.site/*",
    "http://127.0.0.1:3220/*",
    "http://localhost:3220/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["conteudo.js"],
      "css": ["conteudo.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timeline YT",
    "default_icon": { "16": "icone-16.png", "32": "icone-32.png", "48": "icone-48.png" }
  },
  "icons": { "16": "icone-16.png", "32": "icone-32.png", "48": "icone-48.png", "128": "icone-128.png" },
  "commands": {
    "mais": { "suggested_key": { "default": "Alt+Shift+M" }, "description": "Mais disso (vídeo aberto)" },
    "depois": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Assistir depois (vídeo aberto)" },
    "menos": { "suggested_key": { "default": "Alt+Shift+X" }, "description": "Menos disso (vídeo aberto)" }
  }
}
